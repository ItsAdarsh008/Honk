# Postgres (Neon or any Postgres). Required for persistence and integration tests.
DATABASE_URL=postgres://user:password@host/dbname

# Resend API key. If unset, sign-in codes are printed to the server console
# instead of emailed. That is the intended development behaviour.
RESEND_API_KEY=
EMAIL_FROM="Honk <hello@honk.app>"

# Sign-in emails allowed per rolling 24 hours. Defaults to 100, which is the
# Resend free tier. Honk refuses just before the provider does, so the limit
# arrives as a card explaining itself rather than a failed send. Raise this to
# match the plan if you upgrade. Ignored with no RESEND_API_KEY, since the
# console has no quota.
EMAIL_DAILY_CAP=100

# Public origin, used for invite links and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with a Waterloo account (Microsoft Entra). Optional: with both unset
# the button is hidden and email codes are the only way in. The tenant is
# Waterloo's and is hardcoded, so only uwaterloo.ca accounts can even start.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
